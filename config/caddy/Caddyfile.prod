# =============================================================================
# TalentMail 宿主机统一 Caddy 参考配置
# =============================================================================
# 说明：
#   - 该配置用于宿主机上的统一 Caddy，不是 compose 内嵌 Caddy 的专用配置
#   - TalentMail 生产环境默认监听：
#       * frontend -> 127.0.0.1:13000
#       * backend  -> 127.0.0.1:18000
#   - MAIL_SERVER 证书与 mailserver 证书同步需单独处理
# =============================================================================

{$WEB_DOMAIN} {
    encode gzip zstd

    # 静态资源永久缓存（Nuxt 文件名含 hash，安全缓存）
    @static path /_nuxt/* /icons/* /favicon.ico
    header @static Cache-Control "public, max-age=31536000, immutable"

    # 安全响应头
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{$WEB_DOMAIN}; frame-ancestors 'none'"
        # 移除服务器标识
        -Server
    }

    # 请求日志（用于安全审计）
    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 5
        }
    }

    # 系统 API IP 白名单（仅允许 AuthCenter 服务器访问）
    # SYSTEM_API_ALLOWED_IPS 设为逗号分隔的 IP，如 "1.2.3.4 5.6.7.8"
    # 默认仅允许 localhost
    @system_api path /api/system/*
    handle @system_api {
        @blocked not remote_ip {$SYSTEM_API_ALLOWED_IPS:127.0.0.1}
        respond @blocked "Forbidden" 403
        reverse_proxy 127.0.0.1:18000
    }

    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket 127.0.0.1:18000

    reverse_proxy /api/* 127.0.0.1:18000 {
        health_uri /api/health
        health_interval 30s
        health_timeout 10s
        health_status 2xx

        transport http {
            dial_timeout 10s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }

        lb_try_duration 30s
        lb_try_interval 2s

        @backend_error status 502 503 504
        handle_response @backend_error {
            respond "Backend service temporarily unavailable. Please try again later." 503
        }
    }

    reverse_proxy /* 127.0.0.1:13000 {
        transport http {
            dial_timeout 10s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }

        lb_try_duration 30s
        lb_try_interval 2s

        @frontend_error status 502 503 504
        handle_response @frontend_error {
            respond "Frontend service temporarily unavailable. Please try again later." 503
        }
    }
}

{$MAIL_SERVER} {
    respond "TalentMail Server - Use SMTP/IMAP to connect" 200
}
