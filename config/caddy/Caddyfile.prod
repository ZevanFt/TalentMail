# =============================================================================
# TalentMail 宿主机统一 Caddy 参考配置
# =============================================================================
# 说明：
#   - 该配置用于宿主机上的统一 Caddy，不是 compose 内嵌 Caddy 的专用配置
#   - TalentMail 生产环境默认监听：
#       * frontend -> 127.0.0.1:13000
#       * backend  -> 127.0.0.1:18000
#   - MAIL_SERVER 证书与 mailserver 证书同步需单独处理
# =============================================================================

{$WEB_DOMAIN} {
    encode gzip zstd

    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @websocket 127.0.0.1:18000

    reverse_proxy /api/* 127.0.0.1:18000 {
        health_uri /api/health
        health_interval 30s
        health_timeout 10s
        health_status 2xx

        transport http {
            dial_timeout 10s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }

        lb_try_duration 30s
        lb_try_interval 2s

        @backend_error status 502 503 504
        handle_response @backend_error {
            respond "Backend service temporarily unavailable. Please try again later." 503
        }
    }

    reverse_proxy /* 127.0.0.1:13000 {
        transport http {
            dial_timeout 10s
            response_header_timeout 30s
            read_timeout 60s
            write_timeout 60s
        }

        lb_try_duration 30s
        lb_try_interval 2s

        @frontend_error status 502 503 504
        handle_response @frontend_error {
            respond "Frontend service temporarily unavailable. Please try again later." 503
        }
    }
}

{$MAIL_SERVER} {
    respond "TalentMail Server - Use SMTP/IMAP to connect" 200
}
